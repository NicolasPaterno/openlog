# ============================================
# OpenLog - Variaveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=openlog
POSTGRES_PASSWORD=openlog_secret
POSTGRES_DB=openlog
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=openlog
RABBITMQ_PASSWORD=openlog_secret
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Redis ---
REDIS_PASSWORD=openlog_secret
REDIS_PORT=6379

# --- OpenAI (usado pelo AI Worker) ---
OPENAI_API_KEY=sk-your-key-here

# --- Ingestion Service (Go) ---
INGESTION_PORT=8080
